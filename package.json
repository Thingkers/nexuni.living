{
  "name": "nexuni-living",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:no-data": "node scripts/run-local-profile.mjs config/no-data.env dev",
    "dev:data": "node scripts/run-local-profile.mjs config/public-data.env dev",
    "build": "next build --webpack",
    "build:no-data": "node scripts/run-local-profile.mjs config/no-data.env build",
    "build:data": "node scripts/run-local-profile.mjs config/public-data.env build",
    "build:cpanel": "npm run build && node scripts/prepare-cpanel.mjs",
    "deploy:cpanel": "bash scripts/deploy-cpanel.sh",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@sentry/nextjs": "^10.62.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.106.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "browser-image-compression": "^2.0.2",
    "date-fns": "^4.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-intl": "^4.13.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.1",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "recharts": "^3.8.1",
    "resend": "^6.12.3",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
